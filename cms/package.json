{
  "name": "@loyalty-hub/cms",
  "version": "0.7.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Backoffice/CMS su Payload (ADR-013): card concorso, card vincita, pop-up, catalogo, regole, tier, concorsi, con workflow per tipo di oggetto (ADR-014)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "build:vercel": "npm run migrate:deploy && npm run bootstrap:admin && next build",
    "migrate:deploy": "DATABASE_URI=\"${POSTGRES_URL_NON_POOLING:-${DATABASE_URL_UNPOOLED:-$DATABASE_URI}}\" timeout 600 payload migrate",
    "bootstrap:admin": "DATABASE_URI=\"${POSTGRES_URL_NON_POOLING:-${DATABASE_URL_UNPOOLED:-$DATABASE_URI}}\" payload run scripts/primo-operatore.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "@payloadcms/storage-vercel-blob": "^3.89.0",
    "@superset-ui/embedded-sdk": "^0.1.3",
    "graphql": "^16.8.1",
    "next": "15.4.11",
    "payload": "3.89.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sass": "^1.80.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "19.1.9",
    "typescript": "5.9.2"
  }
}
