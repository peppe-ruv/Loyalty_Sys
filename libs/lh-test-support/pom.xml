<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.loyaltyhub</groupId>
    <artifactId>loyalty-hub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>lh-test-support</artifactId>
  <packaging>jar</packaging>
  <description>Solo test: letture esatte dei topic Kafka e attese sui consumer group dei listener per gli IT dei moduli
    (docs/06 §9); regole ArchUnit comuni (deny by default, F2-SEC-09). Si dichiara con scope test: non entra nei jar dei
    servizi.</description>

  <!-- Nessuna dipendenza da lh-common (che lo usa nei propri IT): solo ciò che serve alle classi, versioni dalla BOM
       di Spring Boot importata dal parent. Le regole ArchUnit nominano le annotazioni di lh-common per nome. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- EndpointAccessRules (deny by default, F2-SEC-09); versione gestita nel parent. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
    </dependency>
  </dependencies>

</project>
