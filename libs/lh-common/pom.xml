<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.loyaltyhub</groupId>
    <artifactId>loyalty-hub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>lh-common</artifactId>
  <packaging>jar</packaging>
  <description>Starter condiviso: envelope CloudEvents, outbox/inbox, idempotenza, Kafka, errori RFC 9457, actor, seed loader (docs/06 §1).</description>

  <properties>
    <networknt-json-schema.version>1.5.4</networknt-json-schema.version>
    <zonky-embedded-postgres.version>2.0.7</zonky-embedded-postgres.version>
  </properties>

  <dependencies>
    <!-- Core Spring Boot + JDBC (Spring Data JDBC / JdbcClient, DataSource, tx) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jdbc</artifactId>
    </dependency>
    <!-- Web: ProblemDetail (RFC 9457), filtri CORS/MDC, ActorContext (usa Jackson 3, default di Boot 4). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Kafka (docs/06 §5) -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- Migrazioni comuni (outbox, processed_event, approval_history) -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Auto-configurazione Flyway di Spring Boot 4 (modulo separato dalla 4.x). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <!-- OpenAPI (docs/06 §2): /v3/api-docs e /swagger-ui.html; UI spenta nel profilo free (docs/11 §6). Q-341, ADR-046 -->
    <dependency>
      <!-- Verifica dei JWT nel profilo enterprise (ADR-027, M8.2): solo decoder e validatori, senza la catena di filtri
           di Spring Security; l'autorizzazione resta @RequiresRole. Versione dalla BOM di Spring Boot. -->
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <!-- Actuator + Micrometer (health db/kafka, metriche lh_*) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Validatore JSON Schema 2020-12 (docs/05 §9, Q-27). Usa Jackson 2 internamente: resta confinato
         ai test di contratto; il runtime del sistema usa Jackson 3. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${networknt-json-schema.version}</version>
    </dependency>

    <!-- ==================== TEST ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Kafka in-JVM (EmbeddedKafkaBroker): niente Docker (SPEC-GAP Q-40). Scope provided: serve anche a
         testsupport.EmbeddedKafkaBrokersTestListener (main), che gira solo sul classpath di test dei moduli. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Postgres reale in-process (Zonky), binari da Maven Central: niente Docker (SPEC-GAP Q-40) -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${zonky-embedded-postgres.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <!-- Contratti eventi (docs/05, docs/09) sul classpath di test per il test di contratto. -->
      <testResource>
        <directory>${maven.multiModuleProjectDirectory}/contracts</directory>
        <targetPath>contracts</targetPath>
      </testResource>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Zonky/EmbeddedKafka avviano processi/broker: un fork, no parallelismo aggressivo -->
          <reuseForks>true</reuseForks>
          <forkCount>1</forkCount>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
