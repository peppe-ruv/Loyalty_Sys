# Reverse proxy TLS della vetrina enterprise (F2-DIST-09, ADR-049, Q-620). Letto dal servizio `proxy` di
# deploy/vetrina/compose.vetrina.yml: due nomi su un sottodominio gratuito, certificati ACME automatici
# (sfida HTTP-01 sulla porta 80 o TLS-ALPN-01 sulla 443), redirect da http a https.
# Nessun'altra destinazione: il proxy parla solo con `web` e `idp` sulla rete interna.
{
	# API di amministrazione spenta: niente configurazione a runtime da localhost:2019.
	admin off
	servers {
		# Solo TCP (porte 80 e 443 pubblicate in TCP): niente HTTP/3 su UDP.
		protocols h1 h2
	}
}

(intestazioni) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Web (BFF, backoffice, Demo Hub HUB-02). Il web imposta da sé cookie __Host- e CSP.
{$LH_VETRINA_WEB_HOST} {
	import intestazioni
	reverse_proxy web:3000
}

# Keycloak: solo i realm `loyaltyhub` (login, token, JWKS, pagina /device del client lh-cli) e `loyaltyhub-members`
# (membri del portale e widget, ADR-051) e le risorse statiche.
# La console /admin e il realm `master` non passano dal proxy (docs/18 §3.15 punto 2: console mai esposta senza
# allowlist): si usano da 127.0.0.1:8180 dell'host con un tunnel SSH (deploy/vetrina/README.md).
{$LH_VETRINA_IDP_HOST} {
	import intestazioni
	@realm path /realms/loyaltyhub /realms/loyaltyhub/* /realms/loyaltyhub-members /realms/loyaltyhub-members/* /resources/*
	handle @realm {
		reverse_proxy idp:8080
	}
	handle {
		respond 404
	}
}
