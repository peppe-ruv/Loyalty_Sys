# Proxy della vetrina enterprise nel codespace (F2-DIST-09, ADR-050, Q-661). Letto dal servizio `proxy` di
# deploy/vetrina/compose.vetrina.yml. Nessun certificato da ottenere: il TLS lo termina l'inoltro delle porte di GitHub,
# che porta qui il traffico di https://<codespace>-8000.<dominio> e https://<codespace>-8001.<dominio>. Il proxy instrada per porta,
# qualunque sia l'intestazione Host, e parla solo con `web` e `idp` sulla rete interna.
{
	# API di amministrazione spenta: niente configurazione a runtime da localhost:2019.
	admin off
	# Nessun certificato da ottenere: solo HTTP dietro l'inoltro delle porte.
	auto_https off
	servers {
		protocols h1
	}
}

(intestazioni) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Web (BFF, backoffice, Demo Hub HUB-02). Dall'esterno si arriva solo in https: lo schema inoltrato è sempre https.
:8000 {
	import intestazioni
	# L'inoltro delle porte di GitHub riscrive l'intestazione `Origin` che coincide con il suo dominio:
	# `https://<codespace>-8000.<dominio>` arriva qui come `http://localhost:8000` (o `https://localhost:8000`), mentre
	# `Host` e `Referer` restano quelli pubblici (github/community discussione 147513, «won't fix»). Il BFF confronta `Origin`
	# con LH_WEB_URL e rifiuterebbe ogni scrittura (403 CSRF_REJECTED: registrazione, backoffice, logout). Qui si rimette
	# l'origine pubblica, SOLO per quei due valori esatti; ogni altro `Origin` passa com'è e il BFF lo rifiuta. Gli altri
	# controlli restano intatti: `Sec-Fetch-Site` (una pagina servita davvero da localhost è cross-site per il browser),
	# token X-LH-CSRF legato alla sessione e cookie `SameSite=Lax`.
	@origine_riscritta header_regexp Origin ^https?://localhost:8000$
	request_header @origine_riscritta Origin "https://{$LH_VETRINA_WEB_HOST}"
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto https
	}
}

# Keycloak (porta 8001, pubblica). ADR-051 decisione 8 e Q-670 per i due realm di vetrina; ADR-055 e Q-727 per `master`.
# L'indirizzo pubblico serve i realm `loyaltyhub` e `loyaltyhub-members` con le loro console di amministrazione. Il realm
# `master` e' CHIUSO (404) finche' il proprietario non ha messo nel codespace il segreto LH_VETRINA_MASTER_ADMIN_PASSWORD:
# solo allora vetrina.sh crea il suo utente e copia deploy/vetrina/caddy/master-aperta.caddy in master-console.caddy, che
# questo file importa; senza segreto vi finisce master-chiusa.caddy (vuoto). Ordine delle regole, che conta:
#   1. percorsi con trucchi di normalizzazione -> 404 (i permessi sono prefissi e Keycloak normalizza `..` dopo di noi);
#   2. `master`: aperto solo dal file importato (console, login, token, API di amministrazione), altrimenti -> 404;
#   3. elenco dei soli percorsi permessi dei due realm -> Keycloak;
#   4. tutto il resto -> 404.
# I trucchi vengono PRIMA di tutto, anche del permesso di `master`. Verificato con Caddy 2.11.4 (`path` e `path_regexp`
# lavorano sul percorso decodificato, senza distinguere maiuscole e minuscole nei `path`): a console chiusa
# `/Admin/Realms/MASTER/..`, `/realms/%6Daster/..` e `/admin/realms/%4DASTER` danno 404. Il test statico di
# scripts/check-vetrina.mjs controlla l'ordine e l'elenco; i casi sono provati in quel file (con Caddy, se c'e').
# Con la console aperta la protezione e' la password del proprietario, con blocco dei tentativi nel realm (master.json:
# 5 errori, attesa crescente fino a 15 minuti): nessun OTP (ADR-055, opzione B «Solo password»).
:8001 {
	import intestazioni

	# 1. Trucchi di normalizzazione sul percorso gia' decodificato: barra rovesciata, parametri di percorso `;` e un `%`
	#    rimasto dopo la decodifica (doppia codifica, per esempio %252e%252e). I segmenti `..` non servono qui: Caddy
	#    pulisce il percorso prima di confrontarlo (anche %2e%2e, gia' decodificato), quindi `/realms/loyaltyhub/../master/x`
	#    diventa `/realms/master/x` e segue la regola 2 (404 a console chiusa); la prova con Caddy lo verifica. Nessun
	#    percorso legittimo della console contiene questi caratteri. Limite dichiarato: un nome (utente, ruolo, gruppo)
	#    con `%`, `;` o `\` non si puo' gestire dalla console pubblica.
	@trucchi path_regexp trucchi (\\|;|%)
	handle @trucchi {
		respond 404
	}

	# 2. Realm `master`. Il file importato (master-aperta.caddy o master-chiusa.caddy, scelto da vetrina.sh) sta PRIMA del
	#    404, cosi' un permesso vince; se e' vuoto resta il 404. Il 404 copre tutto cio' che riguarda `master`: console
	#    (/admin/master/...), API di amministrazione (/admin/realms/master/...) e login/token/certificati
	#    (/realms/master/...). Con il prefisso senza barra copre anche `master` da solo. /resources/master/... sono i
	#    testi della console del realm (la console li chiede per il realm corrente).
	import /etc/caddy/vetrina/master-console.caddy
	@master path /admin/master* /admin/realms/master* /realms/master* /resources/master /resources/master/*
	handle @master {
		respond 404
	}

	# 3. Permessi. Nessun carattere jolly oltre ai prefissi con barra: `/realms/loyaltyhub*` lascerebbe passare anche
	#    realm con altri nomi.
	@permessi {
		# Login, token, certificati, logout e metadati OIDC dei due realm (browser dell'utente e client del BFF).
		path /realms/loyaltyhub /realms/loyaltyhub/*
		path /realms/loyaltyhub-members /realms/loyaltyhub-members/*
		# File statici dei temi (/resources/<versione>/admin/keycloak.v2/..., /resources/<versione>/common/...): script e
		# fogli di stile della pagina di login e della console. Il tema non contiene dati dei realm.
		path /resources/*
		# La pagina della console di ciascun realm e i suoi punti d'accesso: /whoami, /logout, /messages.json. Senza barra
		# finale Keycloak risponde con un reindirizzamento alla versione con barra.
		path /admin/loyaltyhub/console /admin/loyaltyhub/console/*
		path /admin/loyaltyhub-members/console /admin/loyaltyhub-members/console/*
		# API REST di amministrazione che la console chiama dal browser, solo dei due realm (compreso il realm stesso,
		# GET /admin/realms/<realm>, e le estensioni /ui-ext/*). Le protegge il realm con i suoi token: servono i ruoli di
		# realm-management del client, che gli amministratori di test hanno limitati (Q-671).
		path /admin/realms/loyaltyhub /admin/realms/loyaltyhub/*
		path /admin/realms/loyaltyhub-members /admin/realms/loyaltyhub-members/*
		# Informazioni sul server (versione, provider, temi): la console le legge all'avvio e non parte senza. Risponde solo
		# a chi ha un token di amministratore di un realm; non dipende dal nome del realm.
		path /admin/serverinfo
	}
	handle @permessi {
		reverse_proxy idp:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	# 4. Tutto il resto: /admin, /admin/master/..., /admin/realms (elenco dei realm), /realms/master, /js/*, pagina
	#    iniziale, metriche e salute.
	handle {
		respond 404
	}
}
