# Configurazione dell'host della vetrina enterprise (F2-DIST-09, ADR-049). Copia in /etc/loyaltyhub-vetrina/vetrina.env
# (permessi 0600 o 0644, proprietario root) e adatta i valori. Solo le chiavi qui sotto; NESSUN segreto: i segreti
# li genera `deploy/vetrina/vetrina.sh provision` in $LH_VETRINA_DIR/secrets (regola 20).

# Immagine unica pubblicata, multi-arch (deve avere linux/arm64): meglio con il digest.
LH_IMAGE=ghcr.io/<owner>/loyaltyhub:v0.0.0@sha256:<digest>

# Cartella dei segreti, della CA locale e dei certificati sull'host (fuori dal repository).
LH_VETRINA_DIR=/etc/loyaltyhub-vetrina

# Due nomi su un sottodominio gratuito di un servizio DNS, che puntano all'IP pubblico dell'istanza (Q-620).
LH_VETRINA_WEB_HOST=web-vetrina.example.org
LH_VETRINA_IDP_HOST=idp-vetrina.example.org

# Indirizzo IPv4 privato dell'interfaccia dell'istanza: il proxy pubblica 80 e 443 solo su questo indirizzo.
# Su Oracle Cloud il traffico verso l'IP pubblico arriva a questo indirizzo privato.
LH_VETRINA_PUBLIC_ADDRESS=10.0.0.10

# Origine https della demo per il collegamento di ritorno in HUB-02 (vuota = nessun collegamento).
LH_HUB_DEMO_URL=

# Web e Keycloak solo su loopback, dietro il proxy: unico valore ammesso.
LH_BIND_ADDRESS=127.0.0.1
