# Chiavi di configurazione della vetrina enterprise (F2-DIST-09, ADR-049, ADR-050). Nel codespace le scrive da solo
# `vetrina.sh codespace` a ogni avvio: non serve copiare né modificare questo file. La modalità per un host fisso non è
# supportata e si rimuove (ADR-051 decisione 5). Solo le chiavi qui sotto; NESSUN segreto: i segreti
# li genera `deploy/vetrina/vetrina.sh provision` in $LH_VETRINA_DIR/secrets (regola 20).

# Immagine unica pubblicata, multi-arch (nel codespace serve la variante linux/amd64): meglio con il digest.
LH_IMAGE=ghcr.io/<owner>/loyaltyhub:v0.0.0@sha256:<digest>

# Cartella dei segreti, della CA locale e dei certificati (fuori dal repository).
LH_VETRINA_DIR=/etc/loyaltyhub-vetrina

# Nomi pubblici di web e Keycloak: nel codespace sono gli indirizzi dell'inoltro delle porte di GitHub (Q-661).
LH_VETRINA_WEB_HOST=web-vetrina.example.org
LH_VETRINA_IDP_HOST=idp-vetrina.example.org

# Indirizzo su cui il proxy pubblica le sue porte: nel codespace è 127.0.0.1 e GitHub le inoltra.
LH_VETRINA_PUBLIC_ADDRESS=10.0.0.10

# Origine https della demo per il collegamento di ritorno in HUB-02 (vuota = nessun collegamento).
LH_HUB_DEMO_URL=

# Web e Keycloak solo su loopback, dietro il proxy: unico valore ammesso.
LH_BIND_ADDRESS=127.0.0.1
