# Chiavi di configurazione della vetrina enterprise (F2-DIST-09, ADR-050, ADR-051). Nel codespace le scrive da solo
# `vetrina.sh codespace` a ogni avvio: non serve copiare né modificare questo file. Solo le chiavi qui sotto;
# NESSUN segreto: i segreti li genera `deploy/vetrina/vetrina.sh provision` in $LH_VETRINA_DIR/secrets (regola 20).
# Un vecchio file con `LH_VETRINA_MODE=codespace` resta valido (unico valore ammesso, regola 14); un altro valore è
# rifiutato.

# Immagine unica pubblicata, linux/amd64 nel codespace: meglio con il digest.
LH_IMAGE=ghcr.io/<owner>/loyaltyhub:v0.0.0@sha256:<digest>

# Cartella dei segreti, della CA locale e dei certificati (fuori dal repository).
LH_VETRINA_DIR=/etc/loyaltyhub-vetrina

# Indirizzi pubblici di web (porta 8000), Keycloak (porta 8001) e console del realm `master` (porta 8180, privata):
# sono gli indirizzi dell'inoltro delle porte di GitHub (Q-661, Q-670), <nome del codespace>-<porta>.<dominio di inoltro>.
LH_VETRINA_WEB_HOST=nome-codespace-8000.app.github.dev
LH_VETRINA_IDP_HOST=nome-codespace-8001.app.github.dev
LH_VETRINA_ADMIN_HOST=nome-codespace-8180.app.github.dev

# Origine https della demo per il collegamento di ritorno in HUB-02 (vuota = nessun collegamento).
LH_HUB_DEMO_URL=

# Web e Keycloak solo su loopback, dietro il proxy: unico valore ammesso.
LH_BIND_ADDRESS=127.0.0.1
