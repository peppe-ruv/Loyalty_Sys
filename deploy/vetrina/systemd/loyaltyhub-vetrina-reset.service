# Azzeramento settimanale della vetrina enterprise (Q-624, ADR-049): volumi di Postgres e Kafka ricreati, realm
# reimportato, overlay del realm e account operatore. Nessun backup. Il passo del programma (vetrina.sh programma) è
# interattivo e resta all'operatore (Q-630). Installazione: deploy/vetrina/README.md.
[Unit]
Description=Azzeramento settimanale della vetrina enterprise Loyalty Hub
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=LH_VETRINA_CONFIG=/etc/loyaltyhub-vetrina/vetrina.env
ExecStart=/opt/loyaltyhub/deploy/vetrina/vetrina.sh reset
TimeoutStartSec=45min
