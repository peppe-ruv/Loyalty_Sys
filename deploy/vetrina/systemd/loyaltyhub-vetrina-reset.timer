# Pianificazione dell'azzeramento della vetrina enterprise: ogni lunedì alle 03:00 UTC (Q-624). Persistent recupera
# un azzeramento saltato mentre l'host era spento.
[Unit]
Description=Azzeramento settimanale della vetrina enterprise Loyalty Hub

[Timer]
OnCalendar=Mon *-*-* 03:00:00 UTC
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
