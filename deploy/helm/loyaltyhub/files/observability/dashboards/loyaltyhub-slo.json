          "expr": "1 - ((sum(increase(http_server_requests_seconds_count{job=~\"$job\",uri=~\"/v1/portal/.+\",status=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_requests_seconds_count{job=~\"$job\",uri=~\"/v1/portal/.+\"}[30d]))) / 0.001",
          "legendFormat": "Portale",
          "instant": true,
          "range": false
