          "expr": "histogram_quantile(0.95, sum by (le) (rate(lh_action_to_points_seconds_bucket{job=~\"$job\"}[1h])))",
          "instant": true,
          "range": false
        }
      ],
      "description": "Tempo tra la registrazione dell'azione in insight e quella dell'accredito wallet.points.earned (lh_action_to_points_seconds)."
    },
