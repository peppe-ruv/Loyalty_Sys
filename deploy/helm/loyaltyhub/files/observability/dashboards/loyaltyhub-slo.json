        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - (1 - sum(increase(http_server_requests_seconds_bucket{job=~\"$job\",method=\"POST\",uri=\"/v1/portal/contests/{code}/play\",le=~\"0[.]50*\"}[30d])) / sum(increase(http_server_requests_seconds_count{job=~\"$job\",method=\"POST\",uri=\"/v1/portal/contests/{code}/play\"}[30d]))) / 0.01",
          "legendFormat": "Giocata",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - (1 - sum(increase(lh_action_to_points_seconds_bucket{job=~\"$job\",le=~\"5|5[.]0+\"}[30d])) / sum(increase(lh_action_to_points_seconds_count{job=~\"$job\"}[30d]))) / 0.05",
          "legendFormat": "Azione → punti",
          "instant": true,
          "range": false
        }
      ],
      "description": "Quota di budget d'errore ancora disponibile: sotto zero l'obiettivo è violato nella finestra di 30 giorni."
