{
  "uid": "loyaltyhub-slo",
  "title": "Loyalty Hub — SLO",
  "tags": [
    "loyaltyhub",
    "slo"
  ],
  "description": "Obiettivi di livello del servizio di ADR-036: portale 99,9 %, giocata p99 < 500 ms, azione → punti p95 < 5 s; con consumo del budget d'errore e indicatori operativi (M8.6a).",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Origine dati",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "job",
        "type": "query",
        "label": "Installazione",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_uptime_seconds{job=~\"loyaltyhub[^/]*/hub\"}, job)",
        "definition": "label_values(process_uptime_seconds{job=~\"loyaltyhub[^/]*/hub\"}, job)",
        "includeAll": true,
        "allValue": "loyaltyhub[^/]*/hub",
        "multi": false,
        "current": {},
        "hide": 0,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilità del portale (30 giorni) — obiettivo 99,9 %",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - (sum(increase(http_server_requests_seconds_count{job=~\"$job\",uri=~\"/v1/portal/.+\",status=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_requests_seconds_count{job=~\"$job\",uri=~\"/v1/portal/.+\"}[30d]))",
          "instant": true,
          "range": false
        }
      ],
      "description": "Quota di risposte non 5xx sulle API del portale (/v1/portal/*), su 30 giorni."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Giocata p99 (1 ora) — obiettivo < 500 ms",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"$job\",method=\"POST\",uri=\"/v1/portal/contests/{code}/play\"}[1h])))",
          "instant": true,
          "range": false
        }
      ],
      "description": "POST /v1/portal/contests/{code}/play, 99° percentile della latenza."
    },
