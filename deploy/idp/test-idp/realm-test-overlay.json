{
  "id": "loyaltyhub",
  "realm": "loyaltyhub",
  "identityProviders": [
    {
      "alias": "test-idp",
      "displayName": "IdP Aziendale",
      "providerId": "oidc",
      "enabled": true,
      "firstBrokerLoginFlowAlias": "first broker login with link",
      "config": {
        "authorizationUrl": "${LH_TEST_IDP_AUTH_URL}",
        "tokenUrl": "${LH_TEST_IDP_TOKEN_URL}",
        "clientId": "loyaltyhub-broker",
        "clientSecret": "${LH_TEST_IDP_SECRET}",
        "userInfoUrl": "${LH_TEST_IDP_USERINFO_URL}",
        "issuer": "${LH_TEST_IDP_ISSUER}",
        "syncMode": "IMPORT"
      }
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "ldap",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "uid"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ],
                "user.model.attribute": [
                  "username"
                ]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "mail"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ],
                "user.model.attribute": [
                  "email"
                ]
              }
            }
          ]
        },
        "config": {
          "vendor": [
            "other"
          ],
          "connectionUrl": [
            "ldap://ldap:389"
          ],
          "usersDn": [
            "dc=example,dc=org"
          ],
          "authType": [
            "simple"
          ],
          "bindDn": [
            "cn=admin,dc=example,dc=org"
          ],
          "bindCredential": [
            "${LH_LDAP_BIND_CREDENTIAL}"
          ],
          "searchScope": [
            "1"
          ],
          "useTruststoreSpi": [
            "ldapsOnly"
          ],
          "connectionPooling": [
            "true"
          ],
          "pagination": [
            "true"
          ],
          "allowKerberosAuthentication": [
            "false"
          ],
          "batchSizeForSync": [
            "1000"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "syncRegistrations": [
            "false"
          ]
        }
      }
    ]
  }
}