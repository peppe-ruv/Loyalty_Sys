{
  "id": "loyaltyhub",
  "realm": "loyaltyhub",
  "displayName": "Loyalty Hub",
  "enabled": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Amministra tutto"
      },
      {
        "name": "MARKETING",
        "description": "Crea campagne"
      },
      {
        "name": "LEGAL",
        "description": "Approva concorsi"
      },
      {
        "name": "CARE",
        "description": "Assiste membri"
      },
      {
        "name": "ANALYST",
        "description": "Cruscotti"
      },
      {
        "name": "MEMBER",
        "description": "Membro iscritto"
      },
      {
        "name": "MFA_REQUIRED_ROLE",
        "description": "Triggers Conditional MFA"
      }
    ],
    "client": {}
  },
  "clientScopes": [
    {
      "name": "hub-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-hub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "hub",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "lh-roles-scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "lh_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "lh_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins",
    "hub-audience",
    "lh-roles-scope"
  ],
  "clients": [
    {
      "clientId": "web",
      "name": "Portale e Backoffice (BFF)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LH_WEB_CLIENT_SECRET}",
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "${LH_WEB_URL}/api/auth/backchannel-logout",
        "backchannel.logout.session.required": "true"
      }
    },
    {
      "clientId": "widgets",
      "name": "Widget SDK",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LH_WIDGETS_CLIENT_SECRET}",
      "redirectUris": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "cms",
      "name": "Directus CMS",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LH_CMS_CLIENT_SECRET}",
      "redirectUris": [
        "http://localhost:8055/*",
        "${LH_CMS_URL}/*"
      ],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "lh-jobs",
      "name": "Scheduled Jobs",
      "enabled": true,
      "clientAuthenticatorType": "private-key-jwt",
      "redirectUris": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "jwks.url": "${LH_JOBS_JWKS_URL}"
      }
    },
    {
      "clientId": "crm",
      "name": "Source crm",
      "enabled": true,
      "clientAuthenticatorType": "private-key-jwt",
      "redirectUris": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "jwks.url": "${LH_SOURCE_CRM_JWKS_URL}"
      }
    },
    {
      "clientId": "app",
