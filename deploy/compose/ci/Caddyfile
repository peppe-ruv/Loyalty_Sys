# SOLO CI. Reverse proxy TLS dello smoke enterprise (F2-QA-04, ADR-049, M8.14 V6), letto dal servizio `proxy` di
# deploy/compose/ci/smoke-enterprise.yml. Stesse regole del proxy della vetrina (deploy/vetrina/caddy/Caddyfile):
# web intero, di Keycloak solo il realm `loyaltyhub` e le risorse statiche, console /admin e realm `master` in 404.
# Differenze: certificato della CA di prova generata nel job (niente ACME, niente uscita verso Internet), porta 8443
# (il proxy gira come utente del runner, senza capability), nessun redirect da http.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

(intestazioni) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

https://web.lh.test:8443 {
	tls /etc/lh/tls/server.crt /etc/lh/tls/server.key
	import intestazioni
	reverse_proxy web:3000
}

https://idp.lh.test:8443 {
	tls /etc/lh/tls/server.crt /etc/lh/tls/server.key
	import intestazioni
	@realm path /realms/loyaltyhub /realms/loyaltyhub/* /resources/*
	handle @realm {
		reverse_proxy idp:8080
	}
	handle {
		respond 404
	}
}
