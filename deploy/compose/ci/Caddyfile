# SOLO CI. Reverse proxy TLS dello smoke enterprise (F2-QA-04, ADR-049, M8.14 V6), letto dal servizio `proxy` di
# deploy/compose/ci/smoke-enterprise.yml. Stesse regole del proxy della vetrina (deploy/vetrina/caddy/Caddyfile.codespace):
# web intero, di Keycloak solo i realm `loyaltyhub` e `loyaltyhub-members` (ADR-051) e le risorse statiche, console /admin e realm `master` in 404.
# Differenze da Caddyfile.codespace: in CI il TLS lo termina questo proxy con un certificato della CA di prova generata
# nel job, sulla porta 8443 (nella vetrina lo termina l'inoltro delle porte di GitHub su 8000 e 8001); il proxy gira come
# utente del runner, senza capability; non ci sono le console dei realm, quindi `/admin` risponde 404.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

(intestazioni) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

https://web.lh.test:8443 {
	tls /etc/lh/tls/server.crt /etc/lh/tls/server.key
	import intestazioni
	reverse_proxy web:3000
}

https://idp.lh.test:8443 {
	tls /etc/lh/tls/server.crt /etc/lh/tls/server.key
	import intestazioni
	@realm path /realms/loyaltyhub /realms/loyaltyhub/* /realms/loyaltyhub-members /realms/loyaltyhub-members/* /resources/*
	handle @realm {
		reverse_proxy idp:8080
	}
	handle {
		respond 404
	}
}
