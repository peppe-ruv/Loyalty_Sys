#!/bin/sh
export NODE_ENV="production"
export PORT="3000"
export HOSTNAME="0.0.0.0"
# Ruolo all: l'hub gira nello stesso container su 8080 e contiene tutti i moduli (deploy/hub/pom.xml);
# senza questi default il web proverebbe le porte locali 8081-8088 dello sviluppo con ./mvnw.
for svc in INGESTION MEMBER CAMPAIGN WALLET REWARD GAMIFICATION ENGAGEMENT INSIGHT; do
    var="LH_SVC_${svc}_URL"
    eval "[ -n \"\$$var\" ] || export $var=http://localhost:8080"
done
exec node /opt/lh/web/server.js
