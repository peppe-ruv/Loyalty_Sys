<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Loyalty Hub — parent POM del monorepo (M0.1). Java 25, Spring Boot 4.1.x (docs/04 §6, ADR-005, ADR-006). -->
  <groupId>io.loyaltyhub</groupId>
  <artifactId>loyalty-hub-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Loyalty Hub</name>
  <description>Piattaforma loyalty open source ed event-driven — parent del monorepo</description>

  <!--
    Parent autonomo (non eredita da spring-boot-starter-parent): la gestione delle versioni
    passa dall'import del BOM spring-boot-dependencies, così il parent controlla direttamente
    plugin ed enforcer. I moduli sono vuoti in M0.1: prendono corpo da M0.2 in poi (docs/12).
  -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>4.1.1</spring-boot.version>
    <!-- OpenAPI su /v3/api-docs (docs/06 §2, Q-341, ADR-046) -->
    <springdoc.version>3.1.1</springdoc.version>
    <!-- Regole di architettura nei test (deny by default, F2-SEC-09, ADR-042, docs/18 §3.11): libreria di test, solo
         in lh-test-support, che i moduli dichiarano con scope test. -->
    <archunit.version>1.5.1</archunit.version>
    <!-- Token OIDC (Q-410): spring-security-oauth2-jose la porta in lh-common e lh-test-support la usa per i token RS256
         di prova. Non è nel BOM di Spring Boot: una sola versione, gestita qui, perché un aggiornamento di Spring Security
         o di Dependabot non allinei uno dei due moduli e non l'altro. È la versione che Boot 4.1.1 risolve oggi. -->
    <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>

    <!--
      Dipendenze con advisory noti (M8.0, ADR-044). Spring Boot 4.1.1 è l'ultima 4.1.x: le versioni corrette
      si fissano qui, solo patch nella stessa linea. Il BOM è importato (non è il parent), quindi le sue proprietà
      (tomcat.version, jackson-bom.version…) non si sovrascrivono: le versioni sotto valgono tramite le voci
      esplicite o i BOM importati prima di spring-boot-dependencies in dependencyManagement.
      Da togliere quando una 4.1.x del BOM porta versioni uguali o successive.
      - Tomcat 11.0.24 -> 11.0.26: GHSA-9xv2-5v5q-p794 (CVE-2026-65905), GHSA-gcx9-497g-6cp6 (CVE-2026-65182),
        GHSA-h3x4-894j-xpx5 (CVE-2026-68525), critiche, corrette da 11.0.25.
      - Jackson 3.1.5 -> 3.1.7 e Jackson 2 2.21.5 -> 2.21.7: GHSA-q4xh-88c3-wmh7 (CVE-2026-68497, alta,
        DoS su Duration/XMLGregorianCalendar) e GHSA-wjgm-6hv5-3cvf (CVE-2026-19032, moderata, Path),
        corrette da 3.1.6 / 2.21.6.
      - lz4-java 1.10.1 -> 1.11.4: non è nel BOM di Spring Boot, arriva a runtime da kafka-clients 4.2.1
        (anche kafka-clients 4.3.1 dichiara 1.10.2). GHSA-xx22-p4ch-683r (CVE-2026-59949, moderata: XXHash JNI
        senza controllo dei limiti), corretta da 1.11.1; API usata da kafka-clients invariata.
    -->
    <lh.tomcat.version>11.0.26</lh.tomcat.version>
    <lh.jackson3.version>3.1.7</lh.jackson3.version>
    <lh.jackson2.version>2.21.7</lh.jackson2.version>
    <lh.lz4-java.version>1.11.4</lh.lz4-java.version>
  </properties>

  <modules>
    <module>libs/lh-test-support</module>
    <module>libs/lh-common</module>
    <module>services/ingestion-service</module>
    <module>services/member-service</module>
    <module>services/campaign-service</module>
    <module>services/wallet-service</module>
    <module>services/reward-service</module>
    <module>services/gamification-service</module>
    <module>services/engagement-service</module>
    <module>services/insight-service</module>
    <module>deploy/hub</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- GHSA-q4xh-88c3-wmh7, GHSA-wjgm-6hv5-3cvf: BOM Jackson importati prima di quello di Spring Boot (vince il primo). -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${lh.jackson3.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${lh.jackson2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <!-- GHSA-9xv2-5v5q-p794, GHSA-gcx9-497g-6cp6, GHSA-h3x4-894j-xpx5: Tomcat embedded usato da spring-boot-starter-tomcat. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${lh.tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${lh.tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${lh.tomcat.version}</version>
      </dependency>
      <!-- Oggi fuori dal classpath: allineati perché un'aggiunta futura non mescoli due versioni di Tomcat. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-jasper</artifactId>
        <version>${lh.tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat</groupId>
        <artifactId>tomcat-jdbc</artifactId>
        <version>${lh.tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat</groupId>
        <artifactId>tomcat-annotations-api</artifactId>
        <version>${lh.tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat</groupId>
        <artifactId>tomcat-jsp-api</artifactId>
        <version>${lh.tomcat.version}</version>
      </dependency>
      <!-- GHSA-xx22-p4ch-683r: lz4-java transitiva di kafka-clients. -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${lh.lz4-java.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- I test d'integrazione (*IT) girano in fase verify, con failsafe (docs/06 §9). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.6.0</version>
        <!-- Rapporti JUnit col nome visualizzato dei casi ([TB-…] …), letto da scripts/testbook-report.mjs (docs/16 §1bis). -->
        <configuration>
          <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
          </statelessTestsetReporter>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <!-- Testbook<Dominio><Tema>IT inizia per "Test": senza esclusione surefire lo eseguirebbe anche come unit test. -->
            <excludes>
              <exclude>**/*IT.java</exclude>
            </excludes>
            <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
              <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
            </statelessTestsetReporter>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <!-- Nomi dei parametri a runtime: deserializzazione dei record Jackson e binding Spring -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
