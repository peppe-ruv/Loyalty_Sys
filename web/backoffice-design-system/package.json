{
  "name": "@loyalty-hub/backoffice-design-system",
  "version": "0.7.0",
  "private": true,
  "description": "Design system del backoffice Loyalty Hub: contratti dei 15 pattern UI, componenti React che li implementano, token di tema e regole eseguibili (workflow ADR-014, formati KPI, frasi senza ID tecnici).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "default": "./dist/patterns.js"
    },
    "./tokens.css": "./tokens.css",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components.css": "./src/components/components.css"
  },
  "files": [
    "dist",
    "tokens.css",
    "src/components/components.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
