{
  "name": "@loyalty-hub/backoffice-design-system",
  "version": "0.6.2",
  "private": true,
  "description": "Contratti dei 15 pattern UI del backoffice Loyalty Hub, token di tema e regole eseguibili (workflow ADR-014, formati KPI, frasi senza ID tecnici).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "default": "./dist/patterns.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "dist",
    "tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@types/react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  }
}
