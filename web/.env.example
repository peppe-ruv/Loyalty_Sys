# Frontend (docs/07 §3). Copiare in .env.local per lo sviluppo; in produzione impostare su Vercel.

# URL base dei microservizi per il proxy /api/lh/<service> (lato server, mai visto dal browser).
# Nella demo consolidata i 4 core puntano tutti all'hub; gli altri restano non impostati (degraded).
LH_SVC_INGESTION_URL=http://localhost:8081
LH_SVC_MEMBER_URL=http://localhost:8082
LH_SVC_CAMPAIGN_URL=http://localhost:8083
LH_SVC_WALLET_URL=http://localhost:8084
LH_SVC_INSIGHT_URL=http://localhost:8088

# SSE del flusso eventi live (BO-24): l'EventSource va DIRETTO a insight (ADR-020), non dal proxy.
# Deve essere raggiungibile dal browser e avere il CORS aperto (LH_CORS_ALLOWED_ORIGINS lato insight).
NEXT_PUBLIC_LH_INSIGHT_URL=http://localhost:8088

# Profilo (docs/07 §4-bis, docs/11 §8). Assente o `demo`: identità simulata, nessuna delle variabili sotto.
# `enterprise`: login OIDC obbligatorio; configurazione assente o insicura ⇒ il server non parte (INSECURE_CONFIG).
# LH_PROFILE=enterprise
# LH_OIDC_ISSUER=https://idp.example.org/realms/loyaltyhub
# LH_WEB_CLIENT_ID=web
# LH_WEB_CLIENT_SECRET=            # oppure LH_WEB_CLIENT_SECRET_FILE=/run/secrets/lh_web_client_secret
# LH_WEB_URL=https://loyalty.example.org
# LH_WEB_SESSION_KEY=              # openssl rand -base64 32 (oppure LH_WEB_SESSION_KEY_FILE)
# LH_WEB_SESSION_IDLE_SECONDS=1800
# LH_WEB_SESSION_MAX_SECONDS=36000
# LH_WEB_SESSION_MAX_COUNT=10000
# Realm dei membri (ADR-051), facoltativo: con l'emittente il portale fa login lì, con il suo client e una sessione
# separata da quella del backoffice (cookie __Host-lh_msession). Vuota = un solo realm per portale e backoffice.
# LH_OIDC_MEMBER_ISSUER=https://idp.example.org/realms/loyaltyhub-members
# LH_WEB_MEMBER_CLIENT_ID=portal
# LH_WEB_MEMBER_CLIENT_SECRET=     # oppure LH_WEB_MEMBER_CLIENT_SECRET_FILE=/run/secrets/lh_web_member_client_secret
# HUB-02 della vetrina (ADR-049): origine https della demo per il collegamento «Torna alla demo», letta SOLO lato
# server. Vuota = nessun collegamento; un valore non valido lo nasconde e scrive un avviso nel log, senza il valore.
# LH_HUB_DEMO_URL=https://demo.example.org
# Emittente con certificato di una CA interna: PEM della CA, aggiunto (non sostituito) alle CA pubbliche di Node.
# Nel chart viene da roles.web.bff.issuerCaBundle (deploy/README.md «Configurare il login del web»).
# NODE_EXTRA_CA_CERTS=/etc/lh/issuer-ca/ca.crt

# Demo Hub (HUB-01, F2-DIST-09, ADR-049): origine https della vetrina Enterprise, letta a runtime SOLO lato server.
# Vuota o assente = il pulsante «Prova la modalità Enterprise» è nascosto. Ammessa solo un'origine https (niente
# percorso, query, fragment o credenziali); un valore non valido lascia il pulsante nascosto e scrive un avviso nel log
# del server. Il pulsante non compare nemmeno quando questo web gira con LH_PROFILE=enterprise.
LH_HUB_ENTERPRISE_URL=

# Accensione della vetrina dalla demo pubblica (HUB-01, Q-674, ADR-051 decisione 9). Solo profilo `demo`, SOLO lato
# server, mai NEXT_PUBLIC. Entrambe impostate ⇒ il riquadro «Modalità Enterprise» legge e avvia il codespace con
# `GET`/`POST /api/vetrina/codespace` (unica destinazione in uscita: https://api.github.com). Una delle due assente ⇒
# la route risponde 404 e il riquadro mostra «Disponibile su richiesta» (Q-662); serve comunque LH_HUB_ENTERPRISE_URL.
# Nome del codespace (minuscole, cifre, trattini), es. quello di `gh codespace list`:
# LH_VETRINA_CODESPACE=
# Token fine-grained del proprietario, SOLO sul repository Loyalty_Sys, permessi «Codespaces» in lettura e «Codespaces
# lifecycle admin» in scrittura e nient'altro (Q-674, Q-700), scadenza al massimo un anno. Mai nel browser né nei log
# (regola 20): segreto di Vercel.
# LH_VETRINA_GITHUB_TOKEN=

# Utenti di test di HUB-02 (ADR-051, Q-676): schede, codice OTP e login_hint compaiono SOLO con entrambe le variabili,
# e solo in enterprise; LH_TEST_USERS_ALLOWED=true senza LH_ENVIRONMENT=test è INSECURE_CONFIG (regola 22). Le imposta
# `vetrina.sh` nel codespace; in qualunque altra installazione restano assenti.
# LH_TEST_USERS_ALLOWED=true
# LH_ENVIRONMENT=test
