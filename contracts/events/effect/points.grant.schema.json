{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:effect.points.grant:1",
  "title": "effect.points.grant — data (EVT-EFF-01, docs/05 §4)",
  "type": "object",
  "required": [
    "effectId", "campaignCode", "actionId", "actionType",
    "currency", "baseAmount", "campaignMultiplier", "amount", "tierMultiplierApplies", "pendingDays"
  ],
  "properties": {
    "effectId": { "type": "string", "minLength": 1, "x-lh-pii": false },
    "campaignCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,39}$", "x-lh-pii": false },
    "actionId": { "type": "string", "minLength": 1, "x-lh-pii": false },
    "actionType": { "type": "string", "minLength": 1, "x-lh-pii": false },
    "currency": { "enum": ["PTS", "STS"], "x-lh-pii": false },
    "baseAmount": { "type": "integer", "x-lh-pii": false },
    "campaignMultiplier": { "type": "number", "minimum": 0, "x-lh-pii": false },
    "amount": { "type": "integer", "x-lh-pii": false },
    "tierMultiplierApplies": { "type": "boolean", "x-lh-pii": false },
    "pendingDays": { "type": "integer", "minimum": 0, "x-lh-pii": false },
    "description": { "type": "string", "x-lh-pii": false }
  },
  "additionalProperties": true
}
