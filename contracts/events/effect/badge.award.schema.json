{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:effect.badge.award:1",
  "title": "effect.badge.award — data (EVT-EFF-04, docs/05 §4)",
  "type": "object",
  "required": [
    "effectId",
    "campaignCode",
    "actionId",
    "actionType",
    "badgeCode"
  ],
  "properties": {
    "effectId": {
      "type": "string",
      "minLength": 1
    },
    "campaignCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
    },
    "actionId": {
      "type": "string",
      "minLength": 1
    },
    "actionType": {
      "type": "string",
      "minLength": 1
    },
    "badgeCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
    }
  },
  "additionalProperties": true
}
