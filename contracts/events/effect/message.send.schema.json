{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:effect.message.send:1",
  "title": "effect.message.send — data (EVT-EFF-05, docs/05 §4)",
  "type": "object",
  "required": [
    "effectId",
    "campaignCode",
    "actionId",
    "actionType",
    "templateCode"
  ],
  "properties": {
    "effectId": {
      "type": "string",
      "minLength": 1
    },
    "campaignCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
    },
    "actionId": {
      "type": "string",
      "minLength": 1
    },
    "actionType": {
      "type": "string",
      "minLength": 1
    },
    "templateCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
    },
    "params": {
      "type": "object",
      "description": "Valori aggiuntivi per i segnaposto {{data.*}} del template (docs/03 §3.4, SEND_MESSAGE)."
    }
  },
  "additionalProperties": true
}
