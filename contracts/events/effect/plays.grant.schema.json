{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:effect.plays.grant:1",
  "title": "effect.plays.grant — data (EVT-EFF-02, docs/05 §4)",
  "type": "object",
  "required": [
    "effectId",
    "campaignCode",
    "actionId",
    "actionType",
    "contestCode",
    "count"
  ],
  "properties": {
    "effectId": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    },
    "campaignCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    },
    "actionType": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    },
    "contestCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
