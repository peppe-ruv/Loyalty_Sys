{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.contest.played:1",
  "title": "fact.contest.played — data (EVT-FACT-51, docs/servizi/gamification-service.md §4)",
  "type": "object",
  "required": [
    "contestCode",
    "playId",
    "outcome"
  ],
  "properties": {
    "contestCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    },
    "playId": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    },
    "outcome": {
      "enum": [
        "WIN",
        "LOSE"
      ],
      "x-lh-pii": false
    },
    "kind": {
      "enum": [
        "FREE_DAILY",
        "CREDIT"
      ],
      "x-lh-pii": false
    },
    "playsAvailable": {
      "type": "integer",
      "minimum": 0,
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
