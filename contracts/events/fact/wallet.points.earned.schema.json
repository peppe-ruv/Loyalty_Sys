{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.wallet.points.earned:1",
  "title": "fact.wallet.points.earned — data (EVT-FACT-20, docs/05 §2, §5)",
  "type": "object",
  "required": ["ledgerEntryId", "currency", "amount", "balanceAfter"],
  "properties": {
    "ledgerEntryId": { "type": "string", "minLength": 1, "x-lh-pii": false },
    "effectId": { "type": "string", "x-lh-pii": false },
    "campaignCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,39}$", "x-lh-pii": false },
    "currency": { "enum": ["PTS", "STS"], "x-lh-pii": false },
    "baseAmount": { "type": "integer", "x-lh-pii": false },
    "tierCode": { "type": "string", "x-lh-pii": false },
    "tierMultiplier": { "type": "number", "minimum": 0, "x-lh-pii": false },
    "amount": { "type": "integer", "x-lh-pii": false },
    "balanceAfter": { "type": "integer", "x-lh-pii": false },
    "lotId": { "type": "string", "x-lh-pii": false },
    "availableAt": { "type": ["string", "null"], "x-lh-pii": false },
    "expiresAt": { "type": ["string", "null"], "x-lh-pii": false },
    "pending": { "type": "boolean", "x-lh-pii": false }
  },
  "additionalProperties": true
}
