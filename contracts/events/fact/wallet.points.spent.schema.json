{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.wallet.points.spent:1",
  "title": "fact.wallet.points.spent — data (EVT-FACT-21, docs/05 §5)",
  "type": "object",
  "required": [
    "ledgerEntryId",
    "currency",
    "amount",
    "balanceAfter",
    "redemptionId"
  ],
  "properties": {
    "ledgerEntryId": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    },
    "currency": {
      "const": "PTS",
      "x-lh-pii": false
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "x-lh-pii": false
    },
    "balanceAfter": {
      "type": "integer",
      "minimum": 0,
      "x-lh-pii": false
    },
    "redemptionId": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
