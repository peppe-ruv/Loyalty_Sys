{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.referral.completed:1",
  "title": "fact.referral.completed — data (EVT-FACT-08, F-REF-02)",
  "type": "object",
  "required": [
    "role",
    "counterpartMemberId",
    "qualifyingActionId"
  ],
  "properties": {
    "role": {
      "enum": [
        "REFERRER",
        "REFEREE"
      ],
      "x-lh-pii": false
    },
    "counterpartMemberId": {
      "type": "string",
      "pattern": "^MBR-[0-9]{6}$",
      "x-lh-pii": false
    },
    "qualifyingActionId": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
