{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.achievement.progressed:1",
  "title": "fact.achievement.progressed — data (EVT-FACT-53, docs/03 §8)",
  "type": "object",
  "required": [
    "achievementCode",
    "periodKey",
    "value",
    "target"
  ],
  "properties": {
    "achievementCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    },
    "periodKey": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    },
    "value": {
      "type": "integer",
      "minimum": 0,
      "x-lh-pii": false
    },
    "target": {
      "type": "integer",
      "minimum": 1,
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
