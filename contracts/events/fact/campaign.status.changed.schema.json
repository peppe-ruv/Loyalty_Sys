{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.campaign.status.changed:1",
  "title": "fact.campaign.status.changed — data (EVT-FACT-11, docs/05 §5)",
  "type": "object",
  "required": ["campaignCode", "newStatus"],
  "properties": {
    "campaignCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,39}$", "x-lh-pii": false },
    "name": { "type": "string", "x-lh-pii": false },
    "previousStatus": { "type": "string", "x-lh-pii": false },
    "newStatus": { "type": "string", "x-lh-pii": false }
  },
  "additionalProperties": true
}
