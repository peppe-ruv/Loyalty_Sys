{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.campaign.evaluated:1",
  "title": "fact.campaign.evaluated — data (EVT-FACT-10, docs/05 §5)",
  "description": "Registro di valutazione di un'azione: campagne applicate ed effetti, campagne saltate con motivo.",
  "type": "object",
  "required": ["actionId", "actionType", "matched", "skipped"],
  "properties": {
    "actionId": { "type": "string", "minLength": 1, "x-lh-pii": false },
    "actionType": { "type": "string", "minLength": 1, "x-lh-pii": false },
    "matched": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["campaignCode", "effects"],
        "properties": {
          "campaignCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,39}$", "x-lh-pii": false },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string", "x-lh-pii": false },
                "currency": { "enum": ["PTS", "STS"], "x-lh-pii": false },
                "amount": { "type": "integer", "x-lh-pii": false }
              },
              "additionalProperties": true
            },
            "x-lh-pii": false
          }
        },
        "additionalProperties": true
      },
      "x-lh-pii": false
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["campaignCode", "reason"],
        "properties": {
          "campaignCode": { "type": "string", "x-lh-pii": false },
          "reason": { "type": "string", "x-lh-pii": false }
        },
        "additionalProperties": true
      },
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
