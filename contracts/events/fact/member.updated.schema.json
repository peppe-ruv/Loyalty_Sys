{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.member.updated:1",
  "title": "fact.member.updated — data (EVT-FACT-02, docs/05 §5)",
  "description": "Snapshot completo del membro, come member.registered.",
  "x-lh-superseded-by": "urn:loyaltyhub:schema:fact.member.updated:2",
  "type": "object",
  "required": ["memberId", "status"],
  "properties": {
    "memberId": { "type": "string", "pattern": "^MBR-[0-9]{6}$", "x-lh-pii": false },
    "firstName": { "type": "string", "x-lh-pii": true },
    "lastName": { "type": "string", "x-lh-pii": true },
    "nickname": { "type": "string", "x-lh-pii": true },
    "email": { "type": "string", "x-lh-pii": true },
    "externalId": { "type": "string", "x-lh-pii": false },
    "status": { "enum": ["ACTIVE", "INACTIVE", "SUSPENDED", "BLOCKED", "CLOSED", "ANONYMIZED"], "x-lh-pii": false },
    "channel": { "type": "string", "x-lh-pii": false },
    "registeredAt": { "type": "string", "format": "date-time", "x-lh-pii": false },
    "birthDate": { "type": "string", "x-lh-pii": true },
    "city": { "type": "string", "x-lh-pii": true },
    "referralCode": { "type": "string", "x-lh-pii": false },
    "referredBy": { "type": ["string", "null"], "x-lh-pii": false },
    "attributes": { "type": "object", "x-lh-pii": true },
    "labels": { "type": "array", "items": { "type": "string" }, "x-lh-pii": false }
  },
  "additionalProperties": true
}
