{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.coupon.used:1",
  "title": "fact.coupon.used — data (EVT-FACT-46, docs/05 §5)",
  "type": "object",
  "required": [
    "couponCode"
  ],
  "properties": {
    "couponCode": {
      "type": "string",
      "minLength": 4,
      "x-lh-pii": false
    },
    "rewardCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
