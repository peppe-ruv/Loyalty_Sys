{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.reward.redemption.fulfilled:1",
  "title": "fact.reward.redemption.fulfilled — data (EVT-FACT-42, docs/05 §5)",
  "type": "object",
  "required": [
    "redemptionId",
    "rewardCode"
  ],
  "properties": {
    "redemptionId": {
      "type": "string",
      "minLength": 1
    },
    "rewardCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
    },
    "couponCode": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
