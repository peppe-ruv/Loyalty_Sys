  "type": "object",
  "required": [
    "contestCode",
    "newStatus"
  ],
  "properties": {
    "contestCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
    },
    "name": {
      "type": "string"
    },
    "previousStatus": {
      "type": "string"
    },
    "newStatus": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
