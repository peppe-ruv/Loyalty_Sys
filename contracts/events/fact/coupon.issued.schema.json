{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:fact.coupon.issued:1",
  "title": "fact.coupon.issued — data (EVT-FACT-45, docs/05 §5)",
  "type": "object",
  "required": [
    "couponCode",
    "rewardCode",
    "expiresAt",
    "origin"
  ],
  "properties": {
    "couponCode": {
      "type": "string",
      "minLength": 4
    },
    "rewardCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "enum": [
        "REDEMPTION",
        "CAMPAIGN"
      ]
    },
    "redemptionId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
