{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:action.reward.redeemed:1",
  "title": "action.reward.redeemed — data (EVT-ACT-28, docs/05 §3): azione interna dal ponte ← fact.reward.redemption.confirmed",
  "type": "object",
  "required": [
    "rewardCode",
    "pointsCost"
  ],
  "properties": {
    "rewardCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
    },
    "pointsCost": {
      "type": "integer",
      "minimum": 1
    },
    "redemptionId": {
      "type": "string"
    },
    "rewardName": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
