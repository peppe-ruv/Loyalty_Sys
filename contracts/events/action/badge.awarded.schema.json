{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:action.badge.awarded:1",
  "title": "action.badge.awarded — data (EVT-ACT-26, interna dal ponte su fact.badge.awarded)",
  "type": "object",
  "required": [
    "badgeCode"
  ],
  "properties": {
    "badgeCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    },
    "badgeName": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    },
    "origin": {
      "enum": [
        "ACHIEVEMENT",
        "CAMPAIGN"
      ],
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
