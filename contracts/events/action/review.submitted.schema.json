{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:action.review.submitted:1",
  "title": "action.review.submitted — data (EVT-ACT-09, docs/05 §3, fonte ecommerce)",
  "type": "object",
  "required": [
    "productId",
    "rating"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "minLength": 1
