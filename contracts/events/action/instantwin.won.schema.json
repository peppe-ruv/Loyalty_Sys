{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loyaltyhub:schema:action.instantwin.won:1",
  "title": "action.instantwin.won — data (EVT-ACT-24, interna dal ponte su fact.contest.won; docs/03 §6)",
  "type": "object",
  "required": [
    "contestCode",
    "prizeCode",
    "prizeType"
  ],
  "properties": {
    "contestCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    },
    "playId": {
      "type": "string",
      "minLength": 1,
      "x-lh-pii": false
    },
    "prizeCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    },
    "prizeName": {
      "type": "string",
      "x-lh-pii": false
    },
    "prizeType": {
      "enum": [
        "POINTS",
        "COUPON",
        "PHYSICAL"
      ],
      "x-lh-pii": false
    },
    "points": {
      "type": "integer",
      "minimum": 1,
      "x-lh-pii": false
    },
    "rewardCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,39}$",
      "x-lh-pii": false
    }
  },
  "additionalProperties": true
}
